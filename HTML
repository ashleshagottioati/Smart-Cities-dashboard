<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Smart Cities - Interactive Dashboard</title>
  <link rel="stylesheet" href="style.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <header class="header"> 
    <h1>Smart Cities</h1> 
    <nav class="nav"> 
      <ul class="nav-list"> 
        <li><a href="#" class="nav-link">Home</a></li> 
        <li><a href="#" class="nav-link">What is a Smart City?</a></li> 
        <li><a href="#" class="nav-link">Technologies</a></li> 
        <li><a href="#" class="nav-link">Examples</a></li> 
        <li><a href="#" class="nav-link">Impact</a></li> 
        <li><a href="#" class="nav-link">Contact</a></li> 
      </ul> 
    </nav> 
    <button id="theme-toggle" class="btn-theme" aria-label="Toggle Light/Dark Mode">Toggle Mode</button> 
  </header> 

  <section class="hero"> 
    <h2 class="hero-title">Smart Cities of Tomorrow</h2> 
    <p class="hero-subtext">Explore innovation in urban life.</p> 
  </section> 

  <main class="container">
    <!-- Toggle Buttons -->
    <div class="dashboard-toggle">
      <button data-target="traffic" class="toggle-btn active">Traffic</button>
      <button data-target="airquality" class="toggle-btn">Air Quality</button>
      <button data-target="energy" class="toggle-btn">Energy Consumption</button>
      <button data-target="transport" class="toggle-btn">Public Transport</button>
      <button data-target="feedback" class="toggle-btn">Feedback</button>
    </div>

    <!-- Dashboard Sections -->
    <section id="traffic" class="widget dashboard-section active">
      <h2>Traffic Flow</h2>
      <canvas id="trafficChart" width="400" height="200"></canvas>
    </section>

    <section id="airquality" class="widget dashboard-section">
      <h2>Air Quality Index</h2>
      <canvas id="aqiChart" width="400" height="200"></canvas>
    </section>

    <section id="energy" class="widget dashboard-section">
      <h2>Energy Consumption (kWh)</h2>
      <canvas id="energyChart" width="400" height="200"></canvas>
    </section>

    <section id="transport" class="widget dashboard-section">
      <h2>Public Transportation Usage</h2>
      <canvas id="transportChart" width="400" height="200"></canvas>
    </section>

    <section id="feedback" class="widget dashboard-section">
      <h2>Submit Feedback</h2>
      <form id="feedbackForm">
        <textarea placeholder="Enter your feedback"></textarea><br />
        <button type="submit">Submit</button>
      </form>
    </section>
  </main>

  <footer class="footer"> 
    <p>&copy; 2025 Smart Cities Project</p> 
  </footer> 

  <script>
    // Dark Mode Toggle with Persistence
    const themeToggleBtn = document.getElementById('theme-toggle');
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
      document.body.classList.add('dark-mode');
    }
    themeToggleBtn.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      const theme = document.body.classList.contains('dark-mode') ? 'dark' : 'light';
      localStorage.setItem('theme', theme);
    });

    // Dashboard Section Toggle
    const toggleButtons = document.querySelectorAll('.toggle-btn');
    const dashboardSections = document.querySelectorAll('.dashboard-section');
    toggleButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        toggleButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const target = btn.getAttribute('data-target');
        dashboardSections.forEach(section => {
          section.id === target
            ? section.classList.add('active')
            : section.classList.remove('active');
        });
      });
    });

    // Traffic Chart
    new Chart(document.getElementById('trafficChart').getContext('2d'), {
      type: 'line',
      data: {
        labels: ['6am', '9am', '12pm', '3pm', '6pm', '9pm'],
        datasets: [{
          label: 'Traffic Volume',
          data: [120, 300, 180, 240, 320, 150],
          borderColor: '#cc0000',
          backgroundColor: 'rgba(204, 0, 0, 0.2)',
          fill: true,
          tension: 0.3,
          pointRadius: 5,
        }]
      },
      options: { responsive: true }
    });

    // Air Quality Index Chart
    new Chart(document.getElementById('aqiChart').getContext('2d'), {
      type: 'line',
      data: {
        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
        datasets: [{
          label: 'AQI Level',
          data: [40, 50, 65, 70, 55, 60, 45],
          borderColor: '#006699',
          backgroundColor: 'rgba(0, 102, 153, 0.2)',
          fill: true,
          tension: 0.4,
          pointRadius: 4,
        }]
      },
      options: { responsive: true }
    });

    // Energy Consumption Chart
    new Chart(document.getElementById('energyChart').getContext('2d'), {
      type: 'bar',
      data: {
        labels: ['Residential', 'Commercial', 'Industrial', 'Public'],
        datasets: [{
          label: 'Energy Consumption (kWh)',
          data: [800, 1200, 1600, 600],
          backgroundColor: ['#ff9933', '#ffcc66', '#ffcc00', '#ffee99']
        }]
      },
      options: { responsive: true }
    });

    // Public Transport Usage Chart
    new Chart(document.getElementById('transportChart').getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Buses', 'Trains', 'Trams', 'Bikes'],
        datasets: [{
          label: 'Transport Share',
          data: [45, 30, 15, 10],
          backgroundColor: ['#4CAF50', '#2196F3', '#FF9800', '#9C27B0']
        }]
      },
      options: { responsive: true }
    });

    // Feedback Form with Animated Confirmation
    const feedbackForm = document.getElementById('feedbackForm');
    feedbackForm.addEventListener('submit', function (e) {
      e.preventDefault();

      const confirmation = document.createElement('div');
      confirmation.textContent = '✅ Thank you for your feedback!';
      Object.assign(confirmation.style, {
        position: 'fixed',
        bottom: '20px',
        left: '50%',
        transform: 'translateX(-50%)',
        background: '#007acc',
        color: 'white',
        padding: '1rem 2rem',
        borderRadius: '8px',
        boxShadow: '0 0 10px rgba(0,0,0,0.2)',
        zIndex: '1000',
        opacity: '0',
        transition: 'opacity 0.5s ease'
      });
      document.body.appendChild(confirmation);
      setTimeout(() => (confirmation.style.opacity = '1'), 50);
      setTimeout(() => {
        confirmation.style.opacity = '0';
        setTimeout(() => document.body.removeChild(confirmation), 500);
      }, 2500);

      e.target.querySelector('textarea').value = '';
    });
  </script>
</body>
</html>
