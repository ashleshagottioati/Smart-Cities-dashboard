:root {
    --bg-color: #f0f4f8;
    --text-color: #222;
    --link-color: #007acc;
    --link-hover: #004466;
    --header-bg: #004466;
    --footer-bg: #004466;
    --widget-bg: #ffffff;
}

body.dark-mode {
    --bg-color: #121212;
    --text-color: #e0e0e0;
    --link-color: #4fc3f7;
    --link-hover: #82b1ff;
    --header-bg: #1f1f1f;
    --footer-bg: #1f1f1f;
    --widget-bg: #1e1e1e;
}

body {
    font-family: 'Roboto', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background 0.4s, color 0.4s;
    margin: 0;
    padding: 0;
    line-height: 1.6;
}

.header {
    background-color: var(--header-bg);
    color: white;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-list {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
}

.nav-link {
    color: white;
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem;
}

.nav-link:hover {
    text-decoration: underline;
    color: var(--link-hover);
}

.btn-theme {
    font-size: 1.2rem;
    background: none;
    border: 2px solid white;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    color: white;
    cursor: pointer;
    transition: transform 0.3s ease, background 0.3s ease;
}

.btn-theme:hover {
    transform: scale(1.1);
    background: var(--link-hover);
}

.hero {
    background: url('city-hero.jpg') center/cover no-repeat;
    padding: 100px 20px;
    text-align: center;
    color: white;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
}

.hero-title {
    font-size: 3rem;
    font-weight: bold;
}

.hero-subtext {
    font-size: 1.4rem;
    margin-top: 10px;
}

.container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
}

.widget {
    background-color: var(--widget-bg);
    padding: 2rem;
    margin-bottom: 2rem;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    transition: background 0.3s;
}

.widget h2 {
    margin-bottom: 1rem;
}

textarea {
    width: 100%;
    height: 100px;
    padding: 1rem;
    font-size: 1rem;
    border-radius: 8px;
    border: 1px solid #ccc;
    resize: vertical;
    margin-bottom: 1rem;
}

button[type="submit"] {
    background-color: var(--link-color);
    color: white;
    padding: 0.7rem 1.5rem;
    font-size: 1rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

button[type="submit"]:hover {
    background-color: var(--link-hover);
}

.footer {
    background-color: var(--footer-bg);
    color: white;
    text-align: center;
    padding: 1rem;
    margin-top: 40px;
}

@media (max-width: 768px) {
    .nav-list {
        flex-direction: column;
        gap: 10px;
    }

    .hero-title {
        font-size: 2.2rem;
    }

    .hero-subtext {
        font-size: 1.1rem;
    }
}
